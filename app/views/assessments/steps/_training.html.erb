<h2 class="text-2xl font-bold">
  ¿Dónde vas a entrenar?
</h2>

<p class="mt-2 text-slate-400">
  Adaptaremos los ejercicios al material que realmente tienes disponible.
</p>

<%= form_with model: @profile,
              url: assessments_path(step: "training"),
              method: :post,
              class: "mt-8 space-y-8" do |form| %>

  <div class="grid gap-4 sm:grid-cols-3">

    <% [
         ["Gimnasio", "gym"],
         ["Casa", "home"],
         ["Exterior", "outdoor"]
       ].each do |label, value| %>

      <label class="cursor-pointer">

        <%= form.radio_button :training_location,
                              value,
                              class: "peer sr-only" %>

        <div class="rounded-2xl border border-slate-700 bg-slate-800 p-6 text-center peer-checked:border-indigo-500 peer-checked:bg-indigo-500/10">

          <p class="text-lg font-semibold">
            <%= label %>
          </p>

        </div>

      </label>

    <% end %>

  </div>

  <div>

    <%= form.label :training_experience,
                   "Experiencia",
                   class: "mb-2 block text-sm font-medium text-slate-300" %>

    <%= form.select :training_experience,
                    [
                      ["Principiante", "beginner"],
                      ["Intermedio", "intermediate"],
                      ["Avanzado", "advanced"]
                    ],
                    {},
                    class: "w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-white" %>

  </div>

  <div class="flex justify-between">

    <%= link_to "← Atrás",
                new_assessment_path(step: "allergies"),
                class: "rounded-xl border border-slate-700 px-6 py-3 font-semibold" %>

    <%= form.submit "Continuar →",
                    class: "cursor-pointer rounded-xl bg-indigo-600 px-6 py-3 font-semibold" %>

  </div>

<% end %>