<h2 class="text-2xl font-bold">
  ¿Cuánto tiempo tienes?
</h2>

<p class="mt-2 text-slate-400">
  Queremos crear un plan que puedas cumplir de verdad.
</p>

<%= form_with model: @profile,
              url: assessments_path(step: "availability"),
              method: :post,
              class: "mt-8 space-y-8" do |form| %>

  <div>

    <%= form.label :training_days_per_week,
                   "Días de entrenamiento por semana",
                   class: "mb-2 block text-sm font-medium text-slate-300" %>

    <%= form.select :training_days_per_week,
                    (1..7).map { |n| ["#{n} días", n] },
                    {},
                    class: "w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-white" %>

  </div>

  <div>

    <%= form.label :training_minutes_per_session,
                   "Tiempo por sesión",
                   class: "mb-2 block text-sm font-medium text-slate-300" %>

    <%= form.select :training_minutes_per_session,
                    [
                      ["30 minutos", 30],
                      ["45 minutos", 45],
                      ["60 minutos", 60],
                      ["75 minutos", 75],
                      ["90 minutos", 90]
                    ],
                    {},
                    class: "w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-white" %>

  </div>

  <div>

    <%= form.label :preferred_training_time,
                   "Horario preferido",
                   class: "mb-2 block text-sm font-medium text-slate-300" %>

    <%= form.select :preferred_training_time,
                    [
                      ["Mañana", "morning"],
                      ["Mediodía", "midday"],
                      ["Tarde", "afternoon"],
                      ["Noche", "evening"]
                    ],
                    {},
                    class: "w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-3 text-white" %>

  </div>

  <div class="flex justify-between">

    <%= link_to "← Atrás",
                new_assessment_path(step: "training"),
                class: "rounded-xl border border-slate-700 px-6 py-3 font-semibold" %>

    <%= form.submit "Continuar →",
                    class: "cursor-pointer rounded-xl bg-indigo-600 px-6 py-3 font-semibold" %>

  </div>

<% end %>